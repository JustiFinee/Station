ent-ClothingOuterArmorPlateCarrierCivilian = гражданский бронежилет
    .desc = Гражданский бронежилет — по сути бесполезен, так как не вмещает бронеплиты. Но хотя бы лёгкий.

ent-ClothingOuterArmorKevlarVest = кевларовый жилет
    .desc = Ранний пуленепробиваемый жилет — в наши дни практически бесполезен, так как не вмещает бронеплиты. Но хотя бы лёгкий.

ent-ClothingOuterArmorPlateCarrierHeavy = тяжёлый бронежилет
    .desc = Стандартный бронежилет для «критически важного» персонала, не вмещает бронеплиты.

ent-ClothingOuterArmorPlateCarrierHeavyTrack = тяжёлый бронежилет
    .desc = Стандартный бронежилет для «критически важного» персонала, не вмещает бронеплиты. На этом нарисованы белые полосы и огромный средний палец на груди.

ent-ClothingOuterArmorBasicPlateCarrierEmpty = базовый плитник
    .desc = Гладкий и лёгкий плитник с минимальной защитой. Популярен среди страйкболистов и ролевиков.
    .suffix = Пустой

ent-ClothingOuterArmorBasicPlateCarrierKevlar = { ent-ClothingOuterArmorBasicPlateCarrierEmpty }
    .desc = { ent-ClothingOuterArmorBasicPlateCarrierEmpty.desc }
    .suffix = Кевларовая вставка

ent-ClothingOuterArmorWebVestSecEmpty = полицейский разгрузочный жилет
    .desc = Стандартный плитник для полицейских и сотрудников службы безопасности по всему миру и за его пределами.
    .suffix = Пустой

ent-ClothingOuterArmorWebVestSec = { ent-ClothingOuterArmorWebVestSecEmpty }
    .desc = { ent-ClothingOuterArmorWebVestSecEmpty.desc }
    .suffix = Кевларовая вставка

ent-ClothingOuterArmorSurplusVestEmpty = списанный плитник
    .desc = Старый списанный плитник неизвестного происхождения.
    .suffix = Пустой

ent-ClothingOuterArmorSurplusVestKevlar = { ent-ClothingOuterArmorSurplusVestEmpty }
    .desc = { ent-ClothingOuterArmorSurplusVestEmpty.desc }
    .suffix = Кевларовая вставка

ent-ClothingOuterArmorSurplusVestUNEmpty = плитник ООН
    .desc = Устаревший плитник, выдававшийся бойцам ООН.
    .suffix = Пустой

ent-ClothingOuterArmorSurplusVestUNKevlar = { ent-ClothingOuterArmorSurplusVestUNEmpty }
    .desc = { ent-ClothingOuterArmorSurplusVestUNEmpty.desc }
    .suffix = Керамическая плита

ent-ClothingOuterArmorPlateCarrierBlackEgg = плитник с яичным лотком
    .desc = Стандартный плитник, из которого вынули плиты и заменили их картонным лотком из-под яиц, куском поролона и кевларовой вставкой. Полный хлам против пуль, но немного смягчит тупые удары.

ent-ClothingOuterArmorRU6B2Vest = бронежилет 6Б2
    .desc = Очень старый жилет времён Афганской войны. Называть его «бронежилетом» — преувеличение, так как он способен остановить разве что осколки.

ent-BF14ClothingOuterArmorChestplateIron = железная кираса
    .desc = Добротно выкованный нагрудник для профессиональных солдат.

ent-BF14ClothingOuterArmorChainmail = кольчужная броня
    .desc = Кольчужный жилет для ополченцев.

ent-BF14ClothingOuterArmorGambeson = гамбезон
    .desc = Стёганый доспех из плотной ткани.